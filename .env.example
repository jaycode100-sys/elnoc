# ---- ELNOC environment (copy to .env, never commit .env) ----
# Hosting tiers (see HOSTING.md). Tier 0 = local SQLite + Cloudflare tunnel.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BACKUP_BUCKET=elnoc-backups
ELNOC_DB_PATH=./data/elnoc.db
ELNOC_BACKUP_DIR=./backups
ELNOC_SECRET_KEY=change-me-to-32-random-chars-minimum
ELNOC_SESSION_HOURS=12
ELNOC_BASE_URL=http://noc-elnoc.local:8000
ELNOC_TZ=Africa/Lagos

# Read-only source accounts (least privilege)
PRTG_BASE_URL=
PRTG_USERNAME=
PRTG_PASSHASH=
ZABBIX_BASE_URL=
ZABBIX_API_TOKEN=
# Only for Zabbix <5.4 (no API tokens): user.login fallback
ZABBIX_USER=
ZABBIX_PASSWORD=
# SmartOLT: include your tenant subdomain, and use the API key from
# SmartOLT > General > API key (sent as the X-Token header).
SMARTOLT_BASE_URL=https://<your-subdomain>.smartolt.com
SMARTOLT_API_KEY=
SMARTOLT_STATUS_SINCE=
PHOENIX_CSV_PATH=

# Mailbox (IMAP read-only)
MAIL_IMAP_HOST=
MAIL_IMAP_USER=
MAIL_IMAP_PASS=
MAIL_KEYWORDS=downtime,outage,link down,fibre cut

# Delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noc@company.local
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NEW=noc_new_critical_case
WHATSAPP_TEMPLATE_ESC=noc_escalation
SMS_PROVIDER=termii
SMS_API_KEY=
SMS_SENDER=NOC
ALERT_TEST_RECIPIENT=

# Tuning (section 10.2 defaults, team head may change)
ESC_STEP_WAIT_MIN=15
MAJOR_DIGEST_HOURS=4
STALE_WAIT_MIN=120
MTTR_BREACH_MIN=240
CORRELATION_WINDOW_MIN=30
STALE_UPDATE_HOURS=12
REPEAT_UPDATE_HOURS=48
CORE_ACCESS_DELAY_CORE_MIN=1
CORE_ACCESS_DELAY_EDGE_MIN=5

# AI layer (Phase 6, optional)
LLM_API_KEY=
LLM_MODEL=
LLM_ALLOWLIST=datacom,pypi.org
AGENT_DAILY_CAP=50
